# Application Settings
APP_NAME=StockPredict - AI Stock Forecasting Platform
APP_VERSION=1.0.0
DEBUG=False
ENVIRONMENT=production

# API Configuration
API_V1_PREFIX=/api/v1
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_SECRET_KEY_MINIMUM_32_CHARACTERS
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# Database Configuration
DATABASE_URL=postgresql://stockpredict:CHANGE_PASSWORD@db:5432/stockpredict
DATABASE_ECHO=False
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# Redis Configuration
REDIS_URL=redis://redis:6379/0
CACHE_EXPIRE_SECONDS=3600

# Rate Limiting
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_PER_HOUR=500

# Model Configuration
MODEL_TYPE=lstm
MODEL_PATH=./models/lstm_stock_predictor.pth
SEQUENCE_LENGTH=60
PREDICTION_DAYS=30
DEVICE=cpu
BATCH_SIZE=32

# Stock Data Configuration
ALLOWED_TICKERS=["AAPL","GOOGL","MSFT","AMZN","TSLA","META","NVDA","NFLX","BABA","AMD"]
DATA_SOURCE=yfinance
UPDATE_FREQUENCY_HOURS=6

# Technical Indicators
ENABLE_TECHNICAL_INDICATORS=True
RSI_PERIOD=14
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
BOLLINGER_PERIOD=20

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8501","http://frontend:8501"]

# Monitoring
ENABLE_METRICS=True
PROMETHEUS_PORT=9090
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Security
API_KEY_EXPIRE_DAYS=365
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30

# Email (Optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@stockpredict.com

# Cloud Storage (Optional - for model versioning)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=stockpredict-models
AWS_REGION=us-east-1

# External APIs (Optional)
ALPHA_VANTAGE_API_KEY=
POLYGON_API_KEY=
FINNHUB_API_KEY=
